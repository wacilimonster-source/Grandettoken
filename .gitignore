# ── 构建产物 ──
app/src-tauri/target/
app/core/target/
target/
# tauri-build 自动生成的 ACL schema
app/src-tauri/gen/schemas/

# ── 工具链(约 1 GB,绝不入库)──
build/dl/
# 一次性探针 / 补丁脚本与调研用参考源码的暂存区(AGENTS.md 2.2:用完即删)
build/tmp/
# 静态 WebView2 加载器归档(由 make-webview2-static.ps1 从 cargo registry 现成产物重打)
build/webview2-static/out/
build/mingw64/
build/git/

# ── 依赖 ──
node_modules/

# ── 本地数据:SQLite 快照里可能含余额与用量历史 ──
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

*.db.bak
# QA 留档的 Cookie 罐备份(含会话),不区分清洁前后
build/qa/**/Cookies.*
build/qa/**/Cookies.clean

# ── 密钥 / 凭据(理论上不会落到文件,防御性忽略)──
*.pem
*.key
*.p12
*.pfx
.env
.env.*
secrets.json
credentials.json
*.secret

# ── 编辑器 / 系统 ──
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# ── 自动化验证产物:本地留档,不进版本库 ──
# 这些是脚本生成的机器产物(每份 1–11 MB),历史上被误提交进来,
# 会永久撑大 .git 并淹没 diff。只保留体积小的汇总与证据截图。
build/qa/**/*.apk
build/qa/refresh-*.json
build/qa/perf-*.json
.trae-html-share-packages/

# ── AI 代理的工作目录(memory / plans / rollout 之类,不是项目文件)──
.workbuddy/
.workbuddy-ai/
.zcode/
# DSH 沙箱 ACL 取证报告(运行期产物)
.dsh-acl-report/

# WebView2/crashpad 在运行目录留下的噪音(不是我们的日志;diag.log 才是)
debug.log
*.log
!.gitignore

# QA 截图(实机验收留档,可能含明文密钥,一律不入库)
build/qa/**/*.png
